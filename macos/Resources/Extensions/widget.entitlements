<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- The app writes widget.json into the "widget" subfolder of its data folder; that subfolder is
         the only place the widget reads (the catalog, notes, logs and settings are out of reach). -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array><string>/Library/Application Support/Alive for Mac/widget/</string></array>
</dict></plist>
